@rendermode InteractiveServer
@using MudBlazor
@using System.Globalization
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="lang-btn" @onclick="ToggleAsync">
    <MudIcon Icon="@Icons.Material.Filled.Language"
             Style="font-size:16px;color:var(--mud-palette-text-secondary);flex-shrink:0;" />
    <span style="font-size:0.75rem;font-weight:600;letter-spacing:0.5px;">
        @CurrentLang.ToUpper()
    </span>
    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
             Class="lang-btn-chevron"
             Style="font-size:15px;color:var(--mud-palette-text-secondary);margin-left:1px;" />
</div>

<MudMenu @ref="_menu" Dense="true"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight">
    @foreach (var lang in _available)
    {
        bool isActive = lang == CurrentLang;
        <MudMenuItem OnClick="() => ChangeLanguage(lang)">
            <div style="display:flex;align-items:center;gap:10px;min-width:150px;">
                <span style="flex:1;font-size:0.875rem;
                             @(isActive ? "color:var(--mud-palette-primary);font-weight:600;" : "")">
                    @GetDisplayName(lang)
                </span>
                @if (isActive)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check"
                             Style="font-size:15px;color:var(--mud-palette-primary);" />
                }
            </div>
        </MudMenuItem>
    }
</MudMenu>

@code {
    private MudMenu? _menu;
    private string[] _available = ["en", "de", "ro"];
    private string CurrentLang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private Task ToggleAsync(MouseEventArgs args) =>
        _menu?.ToggleMenuAsync(args) ?? Task.CompletedTask;

    private async Task ChangeLanguage(string lang)
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var redirect = string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
        var url = $"/Culture/Set?culture={lang}&redirectUri={redirect}";
        try
        {
            await JS.InvokeVoidAsync("window.location.replace", url);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Expected: browser navigated away after redirect.
        }
    }

    private static string GetDisplayName(string lang)
    {
        try
        {
            var c = new CultureInfo(lang);
            return char.ToUpper(c.NativeName[0]) + c.NativeName[1..];
        }
        catch { return lang.ToUpper(); }
    }
}
