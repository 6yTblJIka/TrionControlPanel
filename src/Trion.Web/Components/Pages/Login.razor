@page "/login"
@layout BlankLayout
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Trion.Core.Auth
@using Trion.Core.Abstractions.Auth

@inject EmulatorAuthService       AuthService
@inject TokenService              TokenSvc
@inject NavigationManager         Nav
@inject ProtectedSessionStorage   SessionStorage
@inject GlobalLocalizer           L

<PageTitle>@L["Login_SignIn"] – Trion</PageTitle>

<div class="login-bg">
    <div class="login-glow"></div>

    <div class="login-card trion-card">
        <div class="trion-card-accent" style="width:100%;height:4px;border-radius:10px 10px 0 0;flex-shrink:0;"></div>
        <div class="trion-card-body" style="padding:36px 40px 40px;">

            <!-- Brand -->
            <div class="d-flex justify-center align-center gap-3 mb-2">
                <div class="trion-logo" style="width:40px;height:40px;flex-shrink:0;"></div>
                <div>
                    <div style="font-size:1.4rem;font-weight:800;letter-spacing:3px;
                                color:var(--mud-palette-primary);line-height:1.1;">TRION</div>
                    <div style="font-size:0.7rem;font-weight:500;letter-spacing:1.5px;
                                color:var(--mud-palette-text-secondary);">CONTROL PANEL</div>
                </div>
            </div>

            <MudDivider Class="my-5" />

            <!-- Error -->
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
            }

            <!-- Fields -->
            <MudTextField @bind-Value="_username"
                          Label="@L["Login_Username"]"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Immediate="false"
                          Class="mb-4" />

            <MudTextField @bind-Value="_password"
                          Label="@L["Login_Password"]"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Immediate="false"
                          Class="mb-4" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleLoginAsync"
                       Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" Style="font-size:18px;" />
                @L["Login_SignIn"]
            </MudButton>

        </div>
    </div>
</div>

@code {
    private string  _username = string.Empty;
    private string  _password = string.Empty;
    private string? _error    = null;
    private bool    _loading  = false;

    private bool      _showPassword      = false;
    private InputType _passwordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string    _passwordIcon      => _showPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task HandleLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _error = L["Login_Required"];
            return;
        }

        _error   = null;
        _loading = true;

        try
        {
            var authResult = await AuthService.AuthenticateAsync(_username, _password);

            if (!authResult.Success)
            {
                _error = authResult.FailureReason ?? L["Login_Failed"];
                return;
            }

            var user   = new AuthenticatedUser(authResult.Username!, authResult.GmLevel, "browser");
            var tokens = await TokenSvc.IssueTokensAsync(user);

            await SessionStorage.SetAsync("trion_access_token", tokens.AccessToken);
            Nav.NavigateTo("/");
        }
        catch (Exception)
        {
            _error = L["Login_Error"];
        }
        finally
        {
            _loading = false;
        }
    }
}
