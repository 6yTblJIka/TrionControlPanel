@page "/plugin-store"
@inject Trion.Web.Services.PluginStoreService        StoreService
@inject Trion.Core.Plugins.PluginInstaller           Installer
@inject Trion.Core.Plugins.PluginLoader              PluginLoader

<PageTitle>Plugin Store</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Plugin Store</MudText>

@if (_accountTier != "free")
{
    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mb-4">
        @TierDisplayName(_accountTier) tier
    </MudChip>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @_error
        @if (_error.Contains("Log in"))
        {
            <MudLink Href="/login" Class="ml-2">Sign in</MudLink>
        }
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_plugins.Count == 0 && _error is null)
{
    <MudAlert Severity="Severity.Info">No plugins are available for your account tier.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var p in _plugins)
        {
            var installed  = _installedSlugs.Contains(p.Slug);
            var installing = _installing == p.Slug;

            <MudItem xs="12" sm="6" lg="4">
                <MudCard Outlined="true">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            @if (p.IconUrl is not null)
                            {
                                <MudAvatar>
                                    <img src="@p.IconUrl" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.Extension" />
                                </MudAvatar>
                            }
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@p.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                v@p.Version &bull; @p.Author
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (p.MinTier != "free")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                    @TierDisplayName(p.MinTier)+
                                </MudChip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-2">@p.Description</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @FormatBytes(p.FileSize)
                        </MudText>
                    </MudCardContent>

                    <MudCardActions>
                        @if (installed)
                        {
                            <MudButton Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       Size="Size.Small"
                                       Disabled="true">
                                Installed
                            </MudButton>
                            <MudButton Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       OnClick="() => Uninstall(p.Slug)">
                                Remove
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Color="Color.Primary"
                                       StartIcon="@(installing ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Download)"
                                       Size="Size.Small"
                                       Disabled="@(_installing is not null)"
                                       OnClick="() => Install(p.Slug)">
                                @(installing ? "Installing..." : "Install")
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@if (_installMessage is not null)
{
    <MudAlert Severity="@_installSeverity" Class="mt-4" ShowCloseIcon="true"
              CloseIconClicked="() => _installMessage = null">
        @_installMessage
        @if (_installMessage.Contains("restart"))
        {
            <strong> A restart is required to activate it.</strong>
        }
    </MudAlert>
}

@code {
    private List<Trion.Core.Plugins.PluginStoreEntry> _plugins          = [];
    private HashSet<string>                           _installedSlugs   = [];
    private string                                    _accountTier      = "free";
    private string?                                   _error;
    private string?                                   _installing;
    private string?                                   _installMessage;
    private Severity                                  _installSeverity  = Severity.Info;
    private bool                                      _loading          = true;

    protected override async Task OnInitializedAsync()
    {
        _installedSlugs = [.. Installer.InstalledSlugs()];
        var (plugins, tier, error) = await StoreService.GetAvailablePluginsAsync();
        _plugins      = [.. plugins];
        _accountTier  = tier;
        _error        = error;
        _loading      = false;
    }

    private async Task Install(string slug)
    {
        _installing     = slug;
        _installMessage = null;
        StateHasChanged();

        var result = await Installer.InstallAsync(slug);

        _installing = null;
        if (result.Success)
        {
            _installedSlugs.Add(slug);
            _installSeverity  = Severity.Success;
            _installMessage   = $"Plugin installed successfully. Restart Trion.Web to activate it.";
        }
        else
        {
            _installSeverity = Severity.Error;
            _installMessage  = result.Error ?? "Installation failed.";
        }
        StateHasChanged();
    }

    private void Uninstall(string slug)
    {
        Installer.Uninstall(slug);
        _installedSlugs.Remove(slug);
        _installSeverity = Severity.Info;
        _installMessage  = $"Plugin removed. Restart Trion.Web to fully unload it.";
        StateHasChanged();
    }

    private static string TierDisplayName(string tier) => tier switch
    {
        "support"  => "Support",
        "guardian" => "Guardian",
        "champion" => "Champion",
        "legend"   => "Legend",
        _          => "Free",
    };

    private static string FormatBytes(long bytes) =>
        bytes switch
        {
            < 1024             => $"{bytes} B",
            < 1024 * 1024      => $"{bytes / 1024.0:F1} KB",
            _                  => $"{bytes / (1024.0 * 1024):F1} MB",
        };
}
