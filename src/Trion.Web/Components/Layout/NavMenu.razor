@using Trion.Core.Constants
@inject GlobalLocalizer L
@inject Trion.Core.Plugins.IPluginNavRegistry PluginNav

<nav class="trion-nav" aria-label="Main navigation">

    <NavLink class="trion-nav-item" href="" Match="NavLinkMatch.All" title="@L["Nav_Dashboard"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" />
        </span>
        <span class="trion-nav-label">@L["Nav_Dashboard"]</span>
    </NavLink>

    <NavLink class="trion-nav-item" href="server-control" Match="NavLinkMatch.Prefix" title="@L["Nav_ServerControl"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Dns" />
        </span>
        <span class="trion-nav-label">@L["Nav_ServerControl"]</span>
    </NavLink>

    <NavLink class="trion-nav-item" href="installer" Match="NavLinkMatch.Prefix" title="@L["Nav_Installer"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.InstallDesktop" />
        </span>
        <span class="trion-nav-label">@L["Nav_Installer"]</span>
    </NavLink>

    <NavLink class="trion-nav-item" href="ddns-settings" Match="NavLinkMatch.Prefix" title="@L["Nav_DdnsSettings"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Language" />
        </span>
        <span class="trion-nav-label">@L["Nav_DdnsSettings"]</span>
    </NavLink>

    <NavLink class="trion-nav-item" href="plugin-store" Match="NavLinkMatch.Prefix" title="Plugin Store">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Store" />
        </span>
        <span class="trion-nav-label">Plugin Store</span>
    </NavLink>

    <NavLink class="trion-nav-item" href="plugins" Match="NavLinkMatch.Prefix" title="Installed Plugins">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Extension" />
        </span>
        <span class="trion-nav-label">Plugins</span>
    </NavLink>

    @if (PluginNav.Items.Count > 0)
    {
        <div class="trion-nav-divider"></div>

        @foreach (var item in PluginNav.Items)
        {
            <NavLink class="trion-nav-item" href="@item.Href" Match="NavLinkMatch.Prefix" title="@item.Label">
                <span class="trion-nav-icon">
                    <MudIcon Icon="@item.Icon" />
                </span>
                <span class="trion-nav-label">@item.Label</span>
            </NavLink>
        }
    }

    <div class="trion-nav-divider"></div>

    <NavLink class="trion-nav-item" href="login" Match="NavLinkMatch.Prefix" title="@L["Nav_SignIn"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Login" />
        </span>
        <span class="trion-nav-label">@L["Nav_SignIn"]</span>
    </NavLink>

    <div class="trion-nav-divider"></div>

    <a class="trion-nav-item" href="@ExternalLinks.Discord" target="_blank" rel="noopener noreferrer" title="@L["Nav_Discord"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Forum" />
        </span>
        <span class="trion-nav-label">@L["Nav_Discord"]</span>
    </a>

    <a class="trion-nav-item" href="@ExternalLinks.Support" target="_blank" rel="noopener noreferrer" title="@L["Nav_Support"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" />
        </span>
        <span class="trion-nav-label">@L["Nav_Support"]</span>
    </a>

    <a class="trion-nav-item" href="@ExternalLinks.Donation" target="_blank" rel="noopener noreferrer" title="@L["Nav_Donate"]">
        <span class="trion-nav-icon">
            <MudIcon Icon="@Icons.Material.Filled.Favorite" />
        </span>
        <span class="trion-nav-label">@L["Nav_Donate"]</span>
    </a>

</nav>
