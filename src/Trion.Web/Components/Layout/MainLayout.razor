@inherits LayoutComponentBase
@implements IDisposable
@using System.Globalization

@inject ThemeState ThemeState
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="@ThemeState.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1" Dense="true">
        <button class="trion-brand-btn" @onclick="DrawerToggle" title="Toggle sidebar">
            <div class="trion-logo" style="width:22px;height:22px;flex-shrink:0;"></div>
            <span class="trion-brand-trion">TRION</span>
            <span class="trion-brand-sub">Control Panel</span>
        </button>
        <MudSpacer />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <ThemeSwitcher />
            <LanguageSelector />
        </MudStack>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Variant="DrawerVariant.Mini"
               MiniWidth="60px"
               Width="220px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

<!-- Session countdown badge -- updated every second by idle-logout.js -->
<div id="trion-idle-timer" class="trion-session-badge">
    <MudIcon Icon="@Icons.Material.Outlined.Timer" Style="font-size:14px;" />
    <span id="trion-idle-countdown">15:00</span>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    private bool     _drawerOpen = false;
    private MudTheme _theme      = TrionThemes.BuildMudTheme("TrionBlue");

    protected override void OnInitialized()
    {
        ThemeState.OnChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // -- Culture --------------------------------------------------------
        // Blazor Server's rendering threads don't inherit the culture set by
        // UseRequestLocalization (which only runs on the HTTP request thread).
        // Re-apply it here from the trion_lang cookie so IStringLocalizer
        // returns the correct language inside the interactive SignalR circuit.
        var cookieVal = await JS.InvokeAsync<string?>("trionGetCookie", "trion_lang");
        if (!string.IsNullOrWhiteSpace(cookieVal))
        {
            // Cookie format produced by CookieRequestCultureProvider: "c=de|uic=de"
            var cultureName = cookieVal.Split('|')
                .Select(p => p.Trim())
                .FirstOrDefault(p => p.StartsWith("uic=", StringComparison.Ordinal))
                ?[4..];

            if (!string.IsNullOrWhiteSpace(cultureName))
            {
                try
                {
                    var ci = new CultureInfo(cultureName);
                    CultureInfo.DefaultThreadCurrentCulture   = ci;
                    CultureInfo.DefaultThreadCurrentUICulture = ci;
                    await InvokeAsync(StateHasChanged); // re-render with correct culture
                }
                catch (CultureNotFoundException) { }
            }
        }

        // Restore persisted color
        var savedColor = await JS.InvokeAsync<string?>("localStorage.getItem", "trion_theme_color");
        if (!string.IsNullOrWhiteSpace(savedColor) && TrionThemes.All.Any(t => t.Id == savedColor))
            ThemeState.SetColor(savedColor);

        // Restore persisted variant
        var savedDark = await JS.InvokeAsync<string?>("localStorage.getItem", "trion_theme_dark");
        if (!string.IsNullOrWhiteSpace(savedDark) && bool.TryParse(savedDark, out var isDark))
            ThemeState.SetVariant(isDark);

        // Rebuild theme after restore (fires OnChanged if either changed)
        _theme = TrionThemes.BuildMudTheme(ThemeState.CurrentColorId);
        await InvokeAsync(StateHasChanged);

        // Start inactivity timer -- logs out after 15 min of no user activity
        await JS.InvokeVoidAsync("trionIdle.init");
    }

    private void OnThemeChanged()
    {
        _theme = TrionThemes.BuildMudTheme(ThemeState.CurrentColorId);
        InvokeAsync(StateHasChanged);
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    public void Dispose()
    {
        ThemeState.OnChanged -= OnThemeChanged;
        JS.InvokeVoidAsync("trionIdle.dispose");
    }
}
