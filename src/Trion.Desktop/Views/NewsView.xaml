<UserControl x:Class="Trion.Desktop.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Trion.Desktop.Models"
             mc:Ignorable="d"
             Background="{DynamicResource Background.Primary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="{Binding Loc[LBLTrionNews]}" Style="{StaticResource H1Style}" />
                <TextBlock Text="{Binding Loc[NewsPageCaption]}"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- News list -->
        <ScrollViewer Grid.Row="1" Margin="28,0,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Loading shimmer -->
                <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource ElevatedCardStyle}"
                        Height="60" Opacity="0.5">
                    <TextBlock Text="{Binding Loc[LBLNewsLoading]}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Empty state -->
                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource ElevatedCardStyle}"
                        Padding="20">
                    <TextBlock Text="{Binding Loc[LBLNewsEmpty]}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- News items -->
                <ItemsControl ItemsSource="{Binding NewsItems}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NewsItem}">
                            <Border Style="{StaticResource ElevatedCardStyle}"
                                    Padding="0"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Accent strip -->
                                    <Border Grid.Column="0"
                                            CornerRadius="10,0,0,10"
                                            Background="{DynamicResource Accent.Primary}" />

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category badge -->
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Accent.Subtle}"
                                                    BorderBrush="{DynamicResource Accent.Primary}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Category, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="{DynamicResource Accent.Primary}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Title -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource H4Style}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Date -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PublishedAt}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>

                                        <!-- Summary -->
                                        <TextBlock Text="{Binding Summary}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
