<Window x:Class="Trion.Desktop.Views.GameClientSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trion"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="28,24,28,24"
                    MouseLeftButtonDown="OnTitleBarDrag">

            <!-- Icon + title row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border x:Name="IconBorder"
                        Width="38" Height="38"
                        CornerRadius="19"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock Text="C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White" />
                </Border>

                <TextBlock Text="Game Client Required"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground.Primary}" />
            </StackPanel>

            <!-- Expansion badge -->
            <Border Background="{DynamicResource Background.Secondary}"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="ExpansionLabel"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground.Primary}" />
            </Border>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="21"
                       Foreground="{DynamicResource Foreground.Secondary}"
                       Margin="0,0,0,22"
                       Text="The extraction tools read your WoW game files to generate map, visual map, and movement data the server needs. This only happens once per expansion — all repacks using the same emulator share the generated data." />

            <!-- Client path row -->
            <TextBlock Text="WoW client folder"
                       FontSize="12"
                       Foreground="{DynamicResource Foreground.Secondary}"
                       Margin="0,0,0,6" />

            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ClientPathBox"
                         Grid.Column="0"
                         FontSize="13"
                         Height="34"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"
                         TextChanged="OnPathTextChanged" />

                <Button Grid.Column="1"
                        Content="Browse"
                        Width="80"
                        Height="34"
                        Click="OnBrowse">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Button row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Width="88" Height="34"
                        Margin="0,0,8,0"
                        Click="OnCancel">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />
                    </Button.Style>
                    <Button.Content>Cancel</Button.Content>
                </Button>

                <Button x:Name="ContinueButton"
                        Width="88" Height="34"
                        IsEnabled="False"
                        Click="OnContinue">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />
                    </Button.Style>
                    <Button.Content>Continue</Button.Content>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
