<Window x:Class="Trion.Desktop.Views.TrionMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trion"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="28,24,28,24"
                    MouseLeftButtonDown="OnTitleBarDrag">

            <!-- Icon + title row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border x:Name="IconBorder"
                        Width="38" Height="38"
                        CornerRadius="19"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White" />
                </Border>

                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground.Primary}"
                           TextWrapping="NoWrap" />
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="21"
                       Foreground="{DynamicResource Foreground.Secondary}"
                       Margin="0,0,0,26" />

            <!-- Button row -->
            <StackPanel x:Name="ButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" />

        </StackPanel>
    </Border>
</Window>
