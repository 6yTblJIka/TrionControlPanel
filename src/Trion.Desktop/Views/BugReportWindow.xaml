<Window x:Class="Trion.Desktop.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[BugReportWindowTitle]}"
        Width="480" Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- close button row -->
                <RowDefinition Height="*"    />  <!-- content -->
            </Grid.RowDefinitions>

            <!-- Close button -->
            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    Margin="0,8,8,0"
                    Style="{StaticResource ChromeCloseButtonStyle}"
                    Click="CloseButton_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                      Stroke="{DynamicResource Foreground.Secondary}"
                      StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" />
            </Button>

            <!-- FORM (step 1) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSubmitted, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Margin="40,0,40,32">

                    <!-- Icon + headline -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Path Data="{StaticResource Icon.Bug}"
                              Fill="{DynamicResource Accent.Primary}"
                              Width="26" Height="26" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Loc[BugReportTitle]}"
                                   Style="{StaticResource H2Style}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding Loc[BugReportSubtitle]}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24" />

                    <!-- Category -->
                    <TextBlock Text="{Binding Loc[BugReportCategoryLabel]}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxStyle}"
                              Margin="0,0,0,16"
                              WindowChrome.IsHitTestVisibleInChrome="True" />

                    <!-- Repack name (only when category = repack) -->
                    <StackPanel Visibility="{Binding IsRepackCategorySelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Loc[BugReportRepackLabel]}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />

                        <!-- Dropdown of installed repacks -->
                        <ComboBox ItemsSource="{Binding InstalledRepacks}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedRepack, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0,0,0,16"
                                  Visibility="{Binding HasInstalledRepacks, Converter={StaticResource BoolToVisibility}}"
                                  WindowChrome.IsHitTestVisibleInChrome="True" />

                        <!-- Free-text fallback when nothing is installed -->
                        <TextBox Text="{Binding RepackFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"
                                 Tag="{Binding Loc[BugReportRepackPlaceholder]}"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding HasInstalledRepacks, Converter={StaticResource InverseBoolToVisibility}}"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Text="{Binding Loc[BugReportDescriptionLabel]}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Tag="{Binding Loc[BugReportDescriptionPlaceholder]}"
                             MaxLength="255"
                             Margin="0,0,0,16"
                             WindowChrome.IsHitTestVisibleInChrome="True" />

                    <!-- Content -->
                    <TextBlock Text="{Binding Loc[BugReportContentLabel]}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Tag="{Binding Loc[BugReportContentPlaceholder]}"
                             Height="140"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16"
                             WindowChrome.IsHitTestVisibleInChrome="True" />

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Danger.Primary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                    <!-- Submit button -->
                    <Button Content="{Binding Loc[BugReportSubmit]}"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Margin="0,0,0,10"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                    <!-- Spinner while submitting -->
                    <TextBlock Text="{Binding Loc[BugReportSubmitting]}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Version -->
                    <TextBlock Text="{Binding AppVersion, StringFormat='Trion v{0}'}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Opacity="0.45" />

                </StackPanel>
            </ScrollViewer>

            <!-- SUCCESS (step 2) -->
            <StackPanel Grid.Row="1" Margin="40,0,40,40" VerticalAlignment="Center"
                        Visibility="{Binding IsSubmitted, Converter={StaticResource BoolToVisibility}}">
                <Border Width="56" Height="56" CornerRadius="28"
                        Background="{DynamicResource Accent.Subtle}"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Path Data="{StaticResource Icon.Check}"
                          Fill="{DynamicResource Accent.Primary}"
                          Width="22" Height="22" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding Loc[BugReportSuccessTitle]}"
                           Style="{StaticResource H3Style}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding Loc[BugReportSuccessBody]}"
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,24" />
                <Button Content="{Binding Loc[BugReportClose]}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
