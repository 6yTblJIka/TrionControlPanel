<UserControl x:Class="Trion.Desktop.Views.SinglePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Trion.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Trion.Desktop.Infrastructure.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource Background.Primary}">

    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="EnabledLabel"
                                    TrueValue="Enabled" FalseValue="Disabled" />
        <conv:ColorToDropShadowEffectConverter x:Key="AccentToGlow" BlurRadius="28" ShadowDepth="0" Opacity="1" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- Page header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[TabSPPTitle]}" Style="{StaticResource H1Style}" />
                    <TextBlock Text="{Binding Loc[SPPCaption]}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Loading indicator -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Padding="0,40,0,0">
                <TextBlock Text="{Binding Loc[LBLLoadingPackages]}"
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- No packages available -->
            <Border Visibility="{Binding HasAnyAvailable,
                                 Converter={StaticResource InverseBoolToVisibility}}"
                    Padding="0,40,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}"       Value="False" />
                                    <Condition Binding="{Binding HasAnyAvailable}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Loc[LBLNoPackagesAvailable]}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Loc[LBLUpgradeTierUnlock]}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Emulator cards - full-width stack -->
            <ItemsControl ItemsSource="{Binding Emulators}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EmulatorCardViewModel}">

                        <Grid Margin="0,0,0,14"
                              Visibility="{Binding IsAvailable,
                                           Converter={StaticResource BoolToVisibility}}">

                            <!-- Accent glow layer - fades in when this expansion is enabled -->
                            <Border CornerRadius="10"
                                    IsHitTestVisible="False"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="1"
                                    Effect="{Binding AccentColor, Converter={StaticResource AccentToGlow}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.35" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.35" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Main card - border turns accent when enabled -->
                            <Border Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ElevatedCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />   <!-- accent strip -->
                                    <ColumnDefinition Width="*" />   <!-- card body -->
                                </Grid.ColumnDefinitions>

                                <!-- Accent strip -->
                                <Border Grid.Column="0" CornerRadius="10,0,0,10"
                                        Background="{DynamicResource Accent.Primary}" />

                                <!-- Card body -->
                                <Grid Grid.Column="1" Margin="16,12,16,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />  <!-- main content row -->
                                        <RowDefinition Height="Auto" />  <!-- progress panel -->
                                    </Grid.RowDefinitions>

                                    <!-- Main content: info (left) + buttons (right) -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />       <!-- info -->
                                            <ColumnDefinition Width="14" />      <!-- gutter -->
                                            <ColumnDefinition Width="155" />     <!-- buttons -->
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT: info column -->
                                        <StackPanel Grid.Column="0">

                                            <!-- Header: icon + name + status pill -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon badge: expansion colour matches the website per-expansion CSS gradient -->
                                                <Border Grid.Column="0" Width="34" Height="34"
                                                        CornerRadius="8" Margin="0,0,10,0"
                                                        Background="{Binding AccentBrush}">
                                                    <Image Source="/Resources/Images/world-of-warcraft-100.png"
                                                           Width="22" Height="22"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Name + short name -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource H3Style}" />
                                                    <TextBlock Text="{Binding ShortName}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>

                                                <!-- Status pill -->
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,3"
                                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Background.Elevated}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource Status.Running}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"     Value="Not Installed" />
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource Foreground.Secondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Text"     Value="Installed" />
                                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- Divider under header -->
                                            <Separator Margin="0,10,0,10" />

                                            <!-- Version row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Installed version -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DataContext.Loc[LBLSectionInstalled], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource SectionLabelStyle}"
                                                               Margin="0,0,0,3" />
                                                    <TextBlock Text="{Binding InstalledVersion}"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource Foreground.Primary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource Status.Warning}" />
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="VersionBlink">
                                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                     From="1.0" To="0.2"
                                                                                                     Duration="0:0:0.8" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <RemoveStoryboard BeginStoryboardName="VersionBlink" />
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Update arrow (API emulators only) -->
                                                <TextBlock Grid.Column="1"
                                                           Text="^" FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource Status.Running}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasUpdate}"    Value="True" />
                                                                        <Condition Binding="{Binding HasApiInstall}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Latest version (API emulators only) -->
                                                <StackPanel Grid.Column="2"
                                                            Visibility="{Binding HasApiInstall,
                                                                         Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding DataContext.Loc[LBLSectionLatest], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource SectionLabelStyle}"
                                                               Margin="0,0,0,3" />
                                                    <TextBlock Text="{Binding LatestVersion}"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Foreground.Secondary}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Download count (API repacks only, when non-zero) -->
                                            <TextBlock Text="{Binding DownloadCountText}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="0,8,0,0"
                                                       Visibility="{Binding HasDownloadCount,
                                                                    Converter={StaticResource BoolToVisibility}}" />

                                            <!-- Install path (Custom Core only) -->
                                            <TextBlock Text="{Binding DataContext.Loc[LBLSectionInstallPath], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Style="{StaticResource SectionLabelStyle}"
                                                       Margin="0,10,0,4"
                                                       Visibility="{Binding HasApiInstall,
                                                                    Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Grid Visibility="{Binding HasApiInstall,
                                                               Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Background.Primary}"
                                                        BorderBrush="{DynamicResource Border.Default}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="8,5">
                                                    <TextBlock Text="{Binding InstallPath}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding InstallPath}" />
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Content="..."
                                                        Command="{Binding BrowseInstallPathCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Width="30" Height="28"
                                                        FontSize="13"
                                                        ToolTip="{Binding DataContext.Loc[TooltipChooseFolder], RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>

                                        </StackPanel>

                                        <!-- RIGHT: button column -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                            <!-- Install (hidden once installed) -->
                                            <Button Content="{Binding DataContext.Loc[BtnInstall],
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding InstallCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="30"
                                                    Margin="0,0,0,5"
                                                    Visibility="{Binding IsInstalled,
                                                                 Converter={StaticResource InverseBoolToVisibility}}" />

                                            <!-- Update (only when HasUpdate) -->
                                            <Button Content="{Binding DataContext.Loc[BtnUpdate], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding UpdateCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="30"
                                                    Margin="0,0,0,5"
                                                    Visibility="{Binding HasUpdate,
                                                                 Converter={StaticResource BoolToVisibility}}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource Status.Running}" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Repair + Uninstall side-by-side -->
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="{Binding DataContext.Loc[BtnRepair],
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding RepairCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Height="28" />
                                                <Button Grid.Column="2"
                                                        Content="{Binding DataContext.Loc[BtnUninstall],
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding UninstallCommand}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Height="28" />
                                            </Grid>

                                            <!-- Clear Databases: drop + recreate all DBs from manifest -->
                                            <Button Content="Clear Databases"
                                                    Command="{Binding ClearDatabasesCommand}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="28"
                                                    Margin="0,0,0,5" />

                                            <!-- Enable / Disable -->
                                            <Button Command="{Binding ToggleEnabledCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="30">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource SecondaryButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource Status.Running}" />
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding IsEnabled,
                                                                   Converter={StaticResource EnabledLabel}}"
                                                           FontSize="12" />
                                            </Button>

                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress panel (shown when IsWorking) -->
                                    <Border Grid.Row="1"
                                            Margin="0,18,0,0"
                                            Background="{DynamicResource Background.Primary}"
                                            CornerRadius="8"
                                            Padding="16,14"
                                            Visibility="{Binding IsWorking,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Top row: phase + speed + % + cancel -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PhaseLabel}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource Foreground.Primary}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding SpeedText}"
                                                               Style="{StaticResource MonoStyle}"
                                                               Foreground="{DynamicResource Accent.Primary}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding SpeedText,
                                                                            Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                                           Style="{StaticResource MonoStyle}"
                                                           Foreground="{DynamicResource Foreground.Secondary}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0" />

                                                <Button Grid.Column="2"
                                                        Content="{Binding DataContext.Loc[BtnCancel], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding CancelCommand}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="14,4"
                                                        FontSize="12" />
                                            </Grid>

                                            <!-- Progress bar -->
                                            <ProgressBar Grid.Row="2"
                                                         Value="{Binding Progress}"
                                                         Minimum="0" Maximum="100"
                                                         Height="8"
                                                         Foreground="{Binding AccentBrush}"
                                                         Background="{DynamicResource Background.Elevated}"
                                                         BorderThickness="0"
                                                         Style="{StaticResource ModernProgressBarStyle}" />

                                            <!-- Status text -->
                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding StatusText}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding StatusText,
                                                                    Converter={StaticResource NullToVisibility}}" />
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Grid>
                            </Border>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
