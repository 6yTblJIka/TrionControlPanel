<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Trion.Desktop</AssemblyName>
    <RootNamespace>Trion.Desktop</RootNamespace>
    <Product>Trion Control Panel</Product>
    <Version>0.5.0.16</Version>
    <Authors>FlyingPhoenix</Authors>
    <Company>FlyingPhoenix</Company>
    <Description>Trion Control Panel -- WPF rewrite with MVVM, DI, and custom theming.</Description>
    <PackageProjectUrl>https://flying-phoenix.dev/</PackageProjectUrl>
    <Title>Trion Control Panel</Title>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\res\icons\trion-logo\trion.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trion.Core\Trion.Core.csproj" />
    <ProjectReference Include="..\Trion.Platform\Trion.Platform.csproj" />
  </ItemGroup>

  <!-- After build: build TrionUpdater (any TFM) then copy exe and dll to output -->
  <Target Name="CopyTrionUpdater" AfterTargets="Build">
    <!-- RemoveProperties strips RuntimeIdentifier/SelfContained/PublishSingleFile so that
         a win-x64 self-contained publish of Desktop does not propagate those globals into
         the Updater sub-build. build-installer.ps1 publishes Updater separately. -->
    <MSBuild Projects="..\Trion.Updater\Trion.Updater.csproj" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;IncludeNativeLibrariesForSelfExtract" Targets="Build" />
    <MSBuild Projects="..\Trion.Updater\Trion.Updater.csproj" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;IncludeNativeLibrariesForSelfExtract" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_TrionUpdaterDll" />
    </MSBuild>
    <PropertyGroup>
      <_TrionUpdaterDir>@(_TrionUpdaterDll->'%(RootDir)%(Directory)')</_TrionUpdaterDir>
      <_TrionUpdaterStem>@(_TrionUpdaterDll->'%(Filename)')</_TrionUpdaterStem>
    </PropertyGroup>
    <ItemGroup>
      <_TrionUpdaterFiles Include="$(_TrionUpdaterDir)$(_TrionUpdaterStem).exe" Condition="Exists('$(_TrionUpdaterDir)$(_TrionUpdaterStem).exe')" />
      <_TrionUpdaterFiles Include="$(_TrionUpdaterDir)$(_TrionUpdaterStem).dll" Condition="Exists('$(_TrionUpdaterDir)$(_TrionUpdaterStem).dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_TrionUpdaterFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- All Strings.*.json files are copied automatically; just drop a new file to add a language -->
  <ItemGroup>
    <None Update="Resources\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Shared logo assets linked from the repo, embedded as WPF resources -->
  <ItemGroup>
    <Resource Include="..\..\res\icons\trion-logo\trion.ico">
      <Link>Resources\Images\favicon.ico</Link>
    </Resource>
    <Resource Include="..\..\res\icons\trion-logo\TrionLogoNew.png">
      <Link>Resources\Images\TrionLogoNew.png</Link>
    </Resource>
    <Resource Include="..\..\res\icons\trion-logo\TrionLogoNew250.png">
      <Link>Resources\Images\TrionLogoNew250.png</Link>
    </Resource>
    <Resource Include="..\..\..\PhoenixsWebsite\src\public\assets\img\icons\world-of-warcraft-100.png">
      <Link>Resources\Images\world-of-warcraft-100.png</Link>
    </Resource>
  </ItemGroup>

</Project>
